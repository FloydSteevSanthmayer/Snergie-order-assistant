# Backend (.gitignore) - Python / FastAPI

# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Pytest
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Mypy
.mypy_cache/

# Environment files
.env
.env.*.local

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs
*.log

# Database files
*.sqlite3

# Secrets (ensure real secrets are never committed)
secrets.json
